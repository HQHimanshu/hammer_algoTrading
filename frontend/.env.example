# Project Hammer / AlgoPilot Frontend Environment Variables
# Copy to .env or .env.local for development overrides

# URL of the local FastAPI backend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional Firebase Web Client Configuration (Safe public credentials only)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# NEVER place Grok/xAI API keys, Delta Exchange API secret, or Firebase Admin credentials in this file.
