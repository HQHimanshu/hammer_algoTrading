# Project Hammer - Delta Exchange Testnet Environment Configuration
# Copy this file to .env and configure your credentials.

# Application Metadata & Runtime
APP_NAME=Project Hammer
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Delta Exchange Testnet API Credentials
# Obtain these from: https://testnet.delta.exchange -> Settings -> API Keys
DELTA_API_KEY=your_delta_testnet_api_key_here
DELTA_API_SECRET=your_delta_testnet_api_secret_here
DELTA_BASE_URL=https://testnet-api.delta.exchange

# Trading Engine Safety Controls
# IMPORTANT: TRADING_ENABLED must be explicitly set to True to allow automated order placement.
TRADING_ENABLED=false

# Risk Limits
MAX_POSITION_SIZE=1.0
MAX_DAILY_LOSS=100.0
MAX_OPEN_POSITIONS=1
REQUEST_TIMEOUT_SECONDS=10.0

# Strategy Defaults (Dual Moving Average Crossover + RSI Momentum Filter)
DEFAULT_TRADING_SYMBOL=BTCUSDT
STRATEGY_FAST_PERIOD=5
STRATEGY_SLOW_PERIOD=15
STRATEGY_RSI_PERIOD=14
STRATEGY_RSI_OVERBOUGHT=70
STRATEGY_RSI_OVERSOLD=30

# Persistence & Database Backend
# Options: 'sqlite' or 'firestore'
DATABASE_BACKEND=sqlite
DATABASE_PATH=algopilot.db

# Firebase Cloud Firestore Configuration (when DATABASE_BACKEND=firestore)
# Firebase Project ID for the hackathon: hammer-algotrading
FIREBASE_PROJECT_ID=hammer-algotrading
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# TradeMind AI - Explainable Algorithmic Trading Assistant
# Master switch for AI Assistant (Disabled by default)
AI_ENABLED=false

# AI LLM Provider: 'mock' (offline/tests), 'groq' (official GroqCloud), 'grok' (xAI), or 'gemini'
AI_PROVIDER=mock

# Official Groq API Configuration (when AI_PROVIDER=groq)
# Documentation: https://console.groq.com/docs/api-reference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# RAG & Document Retrieval Parameters
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.50
AI_MAX_CONTEXT_RECORDS=20
AI_MAX_CONTEXT_CHARS=8000
AI_MAX_OUTPUT_TOKENS=1000

# Optional: Official xAI Grok API Configuration (when AI_PROVIDER=grok)
XAI_API_KEY=your_xai_grok_api_key_here
XAI_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=60.0
